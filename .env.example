# =============================================================================
# xPhotoLabs Environment Configuration
# Copy this file to .env and customize for your self-hosted setup.
# =============================================================================

# HTTP Server Binding
PORT=3000
HOST=0.0.0.0

# Public URL where xPhotoLabs is reachable (used for documentation/external links)
APP_URL=http://localhost:3000

# Persistent data directory for SQLite WAL database and 400px/1600px WebP thumbnails.
# In Docker, this maps to the /data volume (e.g., ./data:/data).
DATA_DIR=/data

# Directory where browser uploads and mobile sync originals are stored.
# Defaults to ${DATA_DIR}/uploads. Can be pointed to a mounted NAS path (e.g., /photos/uploads).
UPLOAD_DIR=/data/uploads

# Optional external photo/video folders to index and watch in real time (empty by default).
# Supported formats:
#   - Comma-separated Name:/path   -> EXTERNAL_MOUNTS="Family Photos:/photos,Archive:/photos/archive"
#   - Comma-separated Name=/path   -> EXTERNAL_MOUNTS="Family Photos=/photos"
#   - Plain comma-separated paths  -> EXTERNAL_MOUNTS="/photos"
#   - JSON array                   -> EXTERNAL_MOUNTS='[{"name":"Family Photos","path":"/photos"}]'
EXTERNAL_MOUNTS=

# Optional static Bearer API token for automated mobile/CLI sync
# (POST /api/sync, POST /api/sync/check, and POST /api/upload).
# You can also generate & revoke per-device tokens inside the UI (Storage Mounts).
# Generate a strong token with: openssl rand -hex 32
SYNC_API_TOKEN=

# Seed built-in sample photos/albums when starting with an empty database.
# Defaults to false in production so new self-hosters start with a clean gallery.
# Set to true only if you want to preview the UI with sample imagery.
SEED_DEMO_MEDIA=false

# -----------------------------------------------------------------------------
# Login & security
# -----------------------------------------------------------------------------
# On first visit you create the admin account in the browser. To skip that screen,
# set both of these (only used while no account exists yet):
ADMIN_USER=
ADMIN_PASSWORD=
# Number of reverse proxies in front of the app (Caddy/Nginx/Cloudflare tunnel = 1).
# Needed so login rate-limiting sees the real client IP.
TRUST_PROXY=0
# Extra origins allowed to make changes, comma-separated (only if you use several hostnames).
ALLOWED_ORIGINS=
# Emergency escape hatch: turns sign-in off completely. Not recommended.
AUTH_DISABLED=false
