# xPhotoLabs Configuration (Bare-Metal Debian Linux)
# Copy to /opt/xphotolabs/.env or /etc/xphotolabs/env

# HTTP Server Binding
PORT=3000
HOST=0.0.0.0
APP_URL="http://localhost:3000"

# Local NVMe Data Directory (SQLite WAL DB + 400px/1600px WebP thumbnail cache)
DATA_DIR="/var/lib/xphotolabs"

# Directory for direct browser uploads & mobile sync originals
UPLOAD_DIR="/var/lib/xphotolabs/uploads"

# Optional comma-separated read-only external NAS folders indexed non-destructively
# Format: Name=/mnt/nas/photos,Archive=/mnt/nas/archive (or plain paths /mnt/nas/photos)
EXTERNAL_MOUNTS=""

# Bearer API Token for automated mobile/CLI sync (POST /api/sync/check & POST /api/upload)
# Generate with: openssl rand -hex 32
SYNC_API_TOKEN=""

# Set to "false" in production to skip initial sample gallery seeding when database is empty
SEED_DEMO_MEDIA="true"
